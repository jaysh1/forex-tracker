@inject ApiClient Api

<main class="card login">
    <h1>Forex approver</h1>
    <form @onsubmit="SubmitAsync">
        <label for="pw">Password</label>
        <input id="pw" type="password" autocomplete="current-password" @bind="_password" @bind:event="oninput" />
        <button type="submit" class="btn approve" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
    </form>
    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</main>

@code {
    [Parameter] public EventCallback OnLoggedIn { get; set; }

    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrEmpty(_password)) return;

        _busy = true;
        _error = null;
        try
        {
            _error = await Api.LoginAsync(_password);
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server.";
        }
        finally
        {
            _busy = false;
            _password = "";
        }

        if (_error is null) await OnLoggedIn.InvokeAsync();
    }
}
